{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
    <div class="container">
        {% if app.user %}
            <div class="mb-3 alert alert-info">
                Vous êtes connecté en tant que {{ app.user.userIdentifier }}, 
                <a href="{{ path('app_logout') }}" class="alert-link">Déconnexion</a>
            </div>
        {% endif %}

        <h1 class="h3 mb-4 font-weight-normal">Connexion</h1>

        {# Formulaire Symfony (si loginForm est passé au template) #}
        {% if loginForm is defined %}
            {{ form_start(loginForm, {'attr': {'class': 'cyber-form'}}) }}
                {{ form_errors(loginForm) }}

                <div class="form-group">
                    {{ form_label(loginForm.email) }}
                    {{ form_widget(loginForm.email, {
                        'attr': {
                            'class': 'form-control cyber-input',
                            'placeholder': 'votre@email.com',
                            'autocomplete': 'email',
                            'autofocus': true
                        }
                    }) }}
                </div>

                <div class="form-group">
                    {{ form_label(loginForm.password) }}
                    {{ form_widget(loginForm.password, {
                        'attr': {
                            'class': 'form-control cyber-input',
                            'placeholder': 'Mot de passe',
                            'autocomplete': 'current-password'
                        }
                    }) }}
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button type="submit" class="btn btn-lg cyber-btn">
                    Se connecter
                    <span class="btn-glitch"></span>
                </button>
            {{ form_end(loginForm) }}
        {% else %}
            {# Fallback : formulaire HTML classique #}
            <form action="{{ path('app_login') }}" method="post" class="cyber-form">
                <div class="form-group">
                    <label for="username">Email</label>
                    <input type="text" name="_username" id="username" class="form-control cyber-input" required autocomplete="email" autofocus>
                </div>
                <div class="form-group">
                    <label for="password">Mot de passe</label>
                    <input type="password" name="_password" id="password" class="form-control cyber-input" required autocomplete="current-password">
                </div>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                <button type="submit" class="btn btn-lg cyber-btn">
                    Se connecter
                    <span class="btn-glitch"></span>
                </button>
            </form>
        {% endif %}

        <div class="mt-3">
            <a href="{{ path('app_forgot_password') }}" class="cyber-link">Mot de passe oublié ?</a>
        </div>

        <div class="mt-4 text-center">
            <p>Pas encore de compte ? 
                <a href="{{ path('app_register') }}" class="cyber-link">Créer un compte</a>
            </p>
        </div>
    </div>
{% endblock %}
